{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OvertypeConfig",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "typingSpeedMultiplier": { "type": "number", "minimum": 0.1, "maximum": 10.0 },
        "showHUD": { "type": "boolean" },
        "typingChunkSize": { "type": ["integer", "null"], "minimum": 1 },
        "typingDelayMicroseconds": { "type": ["integer", "null"], "minimum": 0 },
        "appTypingOverrides": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "typingChunkSize": { "type": ["integer", "null"], "minimum": 1 },
              "typingDelayMicroseconds": { "type": ["integer", "null"], "minimum": 0 }
            },
            "required": []
          }
        }
      },
      "required": ["typingSpeedMultiplier", "showHUD"]
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "kind": { "type": "string", "enum": ["openai"] },
          "baseURL": { "type": "string", "format": "uri" },
          "defaultModel": { "type": "string" },
          "timeoutSeconds": { "type": "number", "minimum": 1.0, "maximum": 300.0 },
          "keychainKey": { "type": "string" }
        },
        "required": ["id", "kind", "defaultModel", "timeoutSeconds"]
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string" },
          "enabled": { "type": "boolean" },
          "shortcut": {
            "type": ["object", "null"],
            "properties": {
              "keyCode": { "type": "integer" },
              "modifiers": { "type": "integer" },
              "displayString": { "type": "string" }
            },
            "required": ["keyCode", "modifiers", "displayString"]
          },
          "providerID": { "type": "string" },
          "model": { "type": ["string", "null"] },
          "systemPrompt": { "type": "string" },
          "userPromptTemplate": { "type": "string" },
          "temperature": { "type": "number", "minimum": 0.0, "maximum": 2.0 },
          "maxInputCharacters": { "type": "integer", "minimum": 1 },
          "allowNewlines": { "type": "boolean" },
          "writeStrategy": { "type": "string", "enum": ["typing"] }
        },
        "required": ["id", "title", "enabled", "providerID", "systemPrompt", "userPromptTemplate", "temperature", "maxInputCharacters", "allowNewlines", "writeStrategy"]
      }
    }
  },
  "required": ["global", "providers", "actions"]
}
